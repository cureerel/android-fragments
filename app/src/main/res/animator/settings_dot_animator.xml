<?xml version="1.0" encoding="utf-8"?>
<objectAnimator
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1000">

    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">

        <keyframe
            android:fraction="0.0"
            android:value="0" />

        <keyframe
            android:fraction="0.55"
            android:value="0" />

        <keyframe
            android:fraction="0.75"
            android:value="1" />

        <keyframe
            android:fraction="0.9"
            android:value="0.95" />

        <keyframe
            android:fraction="1.0"
            android:value="1" />

    </propertyValuesHolder>

    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueType="floatType">

        <keyframe
            android:fraction="0.0"
            android:value="0" />

        <keyframe
            android:fraction="0.55"
            android:value="0" />

        <keyframe
            android:fraction="0.75"
            android:value="1" />

        <keyframe
            android:fraction="0.9"
            android:value="0.95" />

        <keyframe
            android:fraction="1.0"
            android:value="1" />

    </propertyValuesHolder>


</objectAnimator>